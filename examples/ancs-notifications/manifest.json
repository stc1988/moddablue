{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_piu.json",
		"$(MODDABLE)/examples/manifest_typings.json"
	],
	"modules": {
		"*": [
			"./main",
			"./NotificationAssets",
			"./NotificationModel",
			"./NotificationsController",
			"./NotificationsView",
			"./components/*",
			"./services/NotificationService"
		]
	},
	"resources": {
		"*-mask": [
			{
				"source": "../assets/fonts/MPLUS1-Medium",
				"size": 16,
				"characterFiles": "../assets/fonts/MPLUS1-chars.txt"
			},
			{
				"source": "../assets/fonts/MPLUS1-SemiBold",
				"name": "MPLUS1-Semibold",
				"size": 18,
				"characterFiles": "../assets/fonts/MPLUS1-chars.txt"
			}
		],
		"*-alpha": ["../assets/masks/status-icons-mask"]
	},
	"config": {
		"ancsAction": "none"
	},
	"creation": {
		"chunk": {
			"initial": 32768
		},
		"heap": {
			"initial": 4096
		},
		"stack": 512
	},
	"typescript": {
		"tsconfig": {
			"compilerOptions": {
				"lib": ["es2024", "esnext.disposable"],
				"target": "ES2024"
			}
		}
	},
	"platforms": {
		"sim": {
			"modules": {
				"NotificationServiceProvider": "./services/MockNotificationService"
			}
		},
		"mac": {
			"modules": {
				"NotificationServiceProvider": "./services/MockNotificationService"
			}
		},
		"lin": {
			"modules": {
				"NotificationServiceProvider": "./services/MockNotificationService"
			}
		},
		"win": {
			"modules": {
				"NotificationServiceProvider": "./services/MockNotificationService"
			}
		},
		"esp32/*": {
			"include": ["../../modules/ancs/manifest.json"],
			"modules": {
				"NotificationServiceProvider": "./services/ANCSNotificationService"
			}
		},
		"...": {
			"error": "ANCS notifications supports the simulator and ESP32 BLE targets"
		}
	}
}
